---
---
<header>
  <div class="container header-inner">
    <div class="brand">
      <h1>Seu Nome</h1>
      <span class="status-dot"></span>
      <p>Disponível</p>
    </div>
    <nav>
      <a href="mailto:email@exemplo.com">Email</a>
      <a href="#" target="_blank">LinkedIn</a>
      <a href="#" target="_blank">GitHub</a>
    </nav>
  </div>
</header>

<style>
  header {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  h1 {
    font-size: 1.25rem;
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1);
  }

  .brand p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
    font-weight: 500;
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  nav a:hover {
    color: var(--primary);
  }
</style>
